<?xml version="1.0" encoding="utf-8"?>
<!-- Android TV home-screen banner (required 320x180dp size for the Leanback launcher row).
     Reuses the launcher icon's folder+play glyph and color scheme, scaled and centered, since
     a VectorDrawable can't render the app name as text without converting it to path data. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="320dp"
    android:height="180dp"
    android:viewportWidth="320"
    android:viewportHeight="180">
    <path
        android:fillColor="#14161A"
        android:pathData="M0,0h320v180h-320z" />
    <group
        android:translateX="63"
        android:translateY="-13"
        android:scaleX="1.8"
        android:scaleY="1.8">
        <path
            android:strokeColor="#5B8CFF"
            android:strokeWidth="4"
            android:strokeLineJoin="round"
            android:strokeLineCap="round"
            android:fillColor="#00000000"
            android:pathData="M30,42 L30,72 L78,72 L78,48 L58,48 L52,42 Z" />
        <path
            android:fillColor="#F4F6F8"
            android:pathData="M48,50 L48,66 L64,58 Z" />
    </group>
</vector>
