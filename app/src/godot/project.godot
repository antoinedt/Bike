; VibeBike ride world (Godot 4.5, embedded in the Android app).

config_version=5

[application]

config/name="VibeBike World"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
boot_splash/show_image=false

[display]

; 6 = sensor: follow the phone's own rotation setting (don't force landscape).
window/handheld/orientation=6
window/size/viewport_width=720
window/size/viewport_height=1000

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0

[shader_globals]

soft_look={
"type": "float",
"value": 0.0
}
